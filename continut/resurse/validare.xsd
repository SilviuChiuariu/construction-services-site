<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="persoane">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="persoana" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="nume" type="xs:string"/>
                            <xs:element name="prenume" type="xs:string"/>
                            <xs:element name="varsta" type="xs:integer"/>
                            <xs:element name="adresa">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="strada" type="xs:string"/>
                                        <xs:element name="numar" type="xs:integer"/>
                                        <xs:element name="localitate" type="xs:string"/>
                                        <xs:element name="judet" type="xs:string"/>
                                        <xs:element name="tara" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="contact">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="email" type="xs:string"/>
                                        <xs:element name="telefon" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="educatie">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="institutie" type="xs:string"/>
                                        <xs:element name="diploma" type="xs:string"/>
                                        <xs:element name="an_absolvire" type="xs:integer"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="experienta">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="job">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="titlu" type="xs:string"/>
                                                    <xs:element name="companie" type="xs:string"/>
                                                    <xs:element name="perioada" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="limbi">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="limba" type="xs:string" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>